{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.felipebarbosavasconcelos13-coder/meta-mcp-organico",
  "description": "Multi-account MCP server for Instagram Graph API, Threads API, WhatsApp Cloud API & Meta platform management",
  "repository": {
    "url": "https://github.com/felipebarbosavasconcelos13-coder/meta-mcp-organico",
    "source": "github"
  },
  "version": "3.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "meta-mcp-organico",
      "version": "3.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "INSTAGRAM_ACCESS_TOKEN",
          "description": "Instagram Graph API access token",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "INSTAGRAM_USER_ID",
          "description": "Instagram Business/Creator account ID",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "INSTAGRAM_MESSAGING_ACCESS_TOKEN",
          "description": "Page access token for Instagram Messaging with Facebook Login",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "INSTAGRAM_PAGE_ID",
          "description": "Facebook Page ID linked to the Instagram account for messaging",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "THREADS_ACCESS_TOKEN",
          "description": "Threads API access token",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "THREADS_USER_ID",
          "description": "Threads user ID",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "META_APP_ID",
          "description": "Meta App ID for token/webhook tools",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "META_APP_SECRET",
          "description": "Meta App Secret for token/webhook tools",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "WHATSAPP_ACCESS_TOKEN",
          "description": "WhatsApp Cloud API system-user token",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "WHATSAPP_PHONE_NUMBER_ID",
          "description": "Default WhatsApp phone number ID",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "WHATSAPP_BUSINESS_ACCOUNT_ID",
          "description": "Default WhatsApp Business Account ID",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "WHATSAPP_BUSINESS_ID",
          "description": "Business IDs to discover WhatsApp accounts from (comma-separated)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "META_ACCOUNTS_FILE",
          "description": "Path to the accounts JSON file (aliases, Threads tokens by env var name)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "META_ALLOWED_ACCOUNTS",
          "description": "Accounts write tools may target (comma-separated)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "META_ACCOUNTS_TTL",
          "description": "Account discovery cache in seconds",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "META_EXPOSE_TOKENS",
          "description": "Return full tokens from exchange/refresh tools",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ]
}
