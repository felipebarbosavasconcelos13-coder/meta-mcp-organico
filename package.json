{
  "name": "meta-mcp-organico",
  "version": "3.0.0",
  "description": "Multi-account MCP server for Instagram Graph API, Threads API, WhatsApp Cloud API & Meta platform management",
  "type": "module",
  "bin": {
    "meta-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md",
    "accounts.example.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "ai",
    "claude",
    "graph-api",
    "instagram",
    "mcp",
    "meta",
    "model-context-protocol",
    "multi-account",
    "threads",
    "whatsapp",
    "whatsapp-cloud-api"
  ],
  "author": "mikusnuz (original); fork by felipebarbosavasconcelos13-coder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipebarbosavasconcelos13-coder/meta-mcp-organico.git"
  },
  "homepage": "https://github.com/felipebarbosavasconcelos13-coder/meta-mcp-organico",
  "bugs": {
    "url": "https://github.com/felipebarbosavasconcelos13-coder/meta-mcp-organico/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.9",
    "typescript": "^5.7.0"
  }
}
